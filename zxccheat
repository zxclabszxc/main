Section:NewButton("УДАЛИТЬ МАШИНА", "ТЫ ДАЛБАЕП?", function()
    task.spawn(function()
        local Players = game:GetService("Players")
        local player = Players.LocalPlayer
        local del = {"Body", "Black", "Grey"}
        local chast = workspace.Vehicles:WaitForChild(player.Name) 
        local gde = chast:WaitForChild("Body")
        for q, w in ipairs(del) do
            local object = gde:FindFirstChild(w)
            if object then
                object:Destroy()
            end
        end
    end)
end)

