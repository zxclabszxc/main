Section:NewButton("АВТОНАРУЧНИКИ", "КИМПИНТЯВА", function()
    local Players = game:GetService("Players")
    local lp = Players.LocalPlayer
    local RS = game:GetService("RunService")

    -- === НАСТРОЙКИ (СТАБИЛЬНЫЕ) ===
    local CUFF_DISTANCE = 7  
    local CUFF_COOLDOWN = 1.2 -- Оптимальный откат
    local EQUIP_WAIT = 0.15   -- Время, чтобы сервер "увидел" наручники в руках
    local ACTION_WAIT = 0.2    -- Время на саму анимацию ареста (чтобы сервер засчитал)

    local lastCuff = 0
    local isProcessing = false

    -- === РЕМУТЫ ===
    local EquipRemote = game.ReplicatedStorage.EJw["b16cb2a5-7735-4e84-a72b-22718da109fc"]
    local CuffRemote = game.ReplicatedStorage.EJw["a3126821-130a-4135-80e1-1d28cece4007"]

    local s2, producer = pcall(require, lp.PlayerScripts.Code.producer)

    local function isWanted(player)
        if not s2 then return false end
        local state = producer.producer:getState()
        local data = state.wantedData.data[player.Name]
        return data and data.wantedLevel and data.wantedLevel >= 1
    end

    local function getCuffTarget()
        local char = lp.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local closest, dist = nil, CUFF_DISTANCE
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= lp and p.Character then
                local pChar = p.Character
                if isWanted(p) and not pChar:GetAttribute("IsCuffed") and pChar.Humanoid.Health > 0 then
                    local d = (char.HumanoidRootPart.Position - pChar.HumanoidRootPart.Position).Magnitude
                    if d < dist then
                        dist = d
                        closest = pChar.HumanoidRootPart
                    end
                end
            end
        end
        return closest
    end

    RS.Heartbeat:Connect(function()
        if isProcessing or (tick() - lastCuff < CUFF_COOLDOWN) then return end
        
        local target = getCuffTarget()
        if target then
            isProcessing = true
            
            -- ШАГ 1: Достаем наручники
            EquipRemote:FireServer("Handcuffs")
            task.wait(EQUIP_WAIT) -- Даем серверу время понять, что у нас в руках
            
            -- ШАГ 2: Старт ареста
            CuffRemote:FireServer(target, "QgA", false)
            
            -- ШАГ 3: Ждем чуть дольше (0.2с - это "золотая середина" для EH)
            task.wait(ACTION_WAIT) 
            
            -- ШАГ 4: Завершение
            CuffRemote:FireServer(target, "QgA", true)
            
            lastCuff = tick()
            print("Cuffed Successfully: " .. target.Parent.Name)
            isProcessing = false
        end
    end)
    
end)
