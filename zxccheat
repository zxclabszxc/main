Section:NewButton("АВТОНАРУЧНИКИ", "КИМПИНТЯВА", function()
    БЕЗ НАРУЧНИКОВ

    local Players = game:GetService("Players")
    local lp = Players.LocalPlayer
    local RS = game:GetService("RunService")

    -- === НАСТРОЙКИ ===
    local CUFF_DISTANCE = 7  -- Расстояние для срабатывания
    local CUFF_COOLDOWN = 1.5 -- Задержка между арестами

    local lastCuff = 0
    local isProcessing = false

    -- === РЕМУТЫ (Только Cuff) ===
    local CuffRemote = game.ReplicatedStorage.EJw["a3126821-130a-4135-80e1-1d28cece4007"]

    -- Модуль для проверки розыска
    local s2, producer = pcall(require, lp.PlayerScripts.Code.producer)

    -- Твоя рабочая проверка розыска (1+)
    local function isWanted(player)
        if not s2 then return false end
        local _producer = rawget(producer, "producer")
        if _producer then
            local wantedData = rawget(rawget(_producer:getState(), "wantedData"), "data")
            local data = rawget(wantedData, player.Name)
            if data then
                local wl = rawget(data, "wantedLevel")
                if wl and wl >= 1 then return true end
            end
        end
        return false
    end

    -- Поиск ближайшего преступника
    local function getCuffTarget()
        local char = lp.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local closest, dist = nil, CUFF_DISTANCE
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local pChar = p.Character
                -- Цель должна: Иметь розыск + Быть живой + Еще не быть в наручниках
                if isWanted(p) and pChar.Humanoid.Health > 0 and not pChar:GetAttribute("IsCuffed") then
                    local d = (char.HumanoidRootPart.Position - pChar.HumanoidRootPart.Position).Magnitude
                    if d < dist then
                        dist = d
                        closest = pChar.HumanoidRootPart
                    end
                end
            end
        end
        return closest
    end

    -- Основной цикл
    RS.Heartbeat:Connect(function()
        if isProcessing or (tick() - lastCuff < CUFF_COOLDOWN) then return end
        
        local target = getCuffTarget()
        if target then
            isProcessing = true
            lastCuff = tick()
            
            -- ШАГ 1: НАЧИНАЕМ АРЕСТ (false)
            -- Передаем: HumanoidRootPart цели, Твой Ключ "QgA", Статус Начала
            CuffRemote:FireServer(target, "QgA", false)
            
            -- ШАГ 2: ПРОПУСК ТАЙМЕРА (Мгновенное завершение)
            -- Если по бегущим целям не срабатывает, увеличь эту задержку до 0.8
            task.wait(0.1)
            
            -- ОТПРАВЛЯЕМ ЗАВЕРШЕНИЕ (true)
            CuffRemote:FireServer(target, "QgA", true)
            
            print("Fast Cuff (No Equip): Арестован " .. target.Parent.Name)
            
            isProcessing = false
        end
    end)
end)
